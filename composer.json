{
    "name": "mahbubhelal/refresh-databases",
    "description": "A Laravel package that extends RefreshDatabase trait to support multiple database connections with separate migration paths. Also provides fast database refreshing with checksum-based caching.",
    "type": "library",
    "keywords": [
        "laravel",
        "testing",
        "database",
        "migrations",
        "refresh-database",
        "multiple-databases",
        "test-database",
        "phpunit",
        "pest"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Md Mahbub Helal",
            "email": "mdhelal00@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/console": "^13.35",
        "illuminate/database": "^13.35",
        "illuminate/support": "^13.35",
        "symfony/finder": "^7.4 || ^8.0",
        "symfony/process": "^7.4 || ^8.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.7",
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32.1",
        "mockery/mockery": "^1.6.15",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3.4",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-phpstan": "^5.2.2",
        "pestphp/pest-plugin-rector": "^5.0.6",
        "pestphp/pest-plugin-type-coverage": "^5.0.3",
        "phpstan/phpstan-strict-rules": "^2.1",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "Mahbub\\RefreshDatabases\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mahbub\\RefreshDatabases\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mahbub\\RefreshDatabases\\RefreshDatabasesServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
